<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:StudySpace.Mobile.Services"
             x:Class="StudySpace.Mobile.Views.SchedulesPage"
             Title="Lịch học sắp tới">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Schedules}" Margin="12">
            <CollectionView.EmptyView>
                <Label Text="Bạn chưa có lịch học sắp tới." TextColor="Gray" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:ScheduleModel">
                    <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,4" BackgroundColor="White">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding GroupName}" FontSize="13" TextColor="#4F46E5" />
                            <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                <Label Text="🕓" FontSize="13" />
                                <Label Text="{Binding StartLocal}" FontSize="13" FontAttributes="Bold" />
                                <Label Text="—" FontSize="13" />
                                <Label Text="{Binding EndLocal}" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding Location, Converter={StaticResource StringNotNullConverter}}">
                                <Label Text="📍" FontSize="13" />
                                <Label Text="{Binding Location}" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding MeetingUrl, Converter={StaticResource StringNotNullConverter}}">
                                <Label Text="🔗" FontSize="13" />
                                <Label Text="{Binding MeetingUrl}" FontSize="13" TextColor="#4F46E5" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Status}" FontSize="12" TextColor="#10B981" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
