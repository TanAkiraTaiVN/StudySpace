<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:StudySpace.Mobile.Services"
             x:Class="StudySpace.Mobile.Views.DocumentsPage"
             Title="Tài liệu">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="10">

        <Picker Grid.Row="0" Title="Chọn nhóm"
                ItemsSource="{Binding Groups}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Documents}">
                <CollectionView.EmptyView>
                    <Label Text="Chưa có tài liệu nào." TextColor="Gray" HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:DocumentModel">
                        <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,4" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding FileName}" FontSize="12" TextColor="Gray" />
                                    <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                                        <Label Text="{Binding SizeText}" FontSize="11" TextColor="Gray" />
                                        <Label Text="{Binding DownloadCount, StringFormat='⬇ {0}'}" FontSize="11" TextColor="Gray" />
                                        <Label Text="{Binding UploadedByName}" FontSize="11" TextColor="Gray" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Tải"
                                        BackgroundColor="#4F46E5" TextColor="White"
                                        Clicked="OnDownloadClicked"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
