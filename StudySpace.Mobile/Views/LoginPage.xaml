<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudySpace.Mobile.Views.LoginPage"
             Title="Đăng nhập"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#4F46E5">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">

            <Label Text="StudySpace" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Quản lý học nhóm &amp; tài liệu" TextColor="White" FontSize="14" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Border Stroke="Transparent" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="12">

                    <Label Text="API URL" FontAttributes="Bold" />
                    <Entry Text="{Binding BaseUrl}" Placeholder="http://10.0.2.2:5000" />

                    <Label Text="Email" FontAttributes="Bold" Margin="0,8,0,0"/>
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="email@example.com" />

                    <Label Text="Mật khẩu" FontAttributes="Bold" Margin="0,8,0,0"/>
                    <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Mật khẩu" />

                    <Button Text="Đăng nhập" Command="{Binding LoginCommand}"
                            BackgroundColor="#4F46E5" TextColor="White"
                            Margin="0,12,0,0" HeightRequest="48" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4F46E5" />

                    <Label Text="{Binding ErrorMessage}" TextColor="Red" />

                    <Label Text="Tài khoản demo: admin@studyspace.com / Admin@123"
                           TextColor="Gray" FontSize="12" Margin="0,8,0,0" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
