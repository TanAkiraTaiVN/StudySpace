<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:StudySpace.Mobile.Services"
             x:Class="StudySpace.Mobile.Views.NotificationsPage"
             Title="Thông báo">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Đã đọc tất cả" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Notifications}" Margin="12">
            <CollectionView.EmptyView>
                <Label Text="Bạn chưa có thông báo." TextColor="Gray" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:NotificationModel">
                    <Border Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,4" BackgroundColor="White">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🔔" FontSize="14" />
                                <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Message}" FontSize="13" TextColor="Gray" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Type}" FontSize="11" TextColor="#4F46E5" />
                                <Label Text="·" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding CreatedAtText}" FontSize="11" TextColor="Gray" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
