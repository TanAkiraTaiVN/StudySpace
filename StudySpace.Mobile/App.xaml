<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:StudySpace.Mobile.Services"
             xmlns:local="clr-namespace:StudySpace.Mobile"
             x:Class="StudySpace.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <svc:StringNotNullConverter x:Key="StringNotNullConverter" />
            <svc:IsMineToColorConverter x:Key="IsMineToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
